#!/bin/sh
# This repo is PUBLIC. Scans every commit about to be pushed. See scripts/privacy-scan.mjs.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git hash-object -t tree /dev/null)"
  else
    base="$remote_sha"
    git cat-file -e "$base" 2>/dev/null || base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git hash-object -t tree /dev/null)"
  fi
  node "$root/scripts/privacy-scan.mjs" --range "$base..$local_sha" || exit 1
done
