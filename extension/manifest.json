{
  "manifest_version": 3,
  "name": "Practice Studio Connector",
  "version": "1.0.0",
  "description": "Lets a local Practice Studio submit to LeetCode through this browser's own LeetCode sign-in.",
  "permissions": ["scripting", "tabs", "cookies"],
  "host_permissions": ["https://leetcode.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
