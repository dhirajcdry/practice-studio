{
  "manifest_version": 3,
  "name": "Practice Studio Connector",
  "version": "1.1.1",
  "description": "Lets a local Practice Studio submit to LeetCode, and premium problems to NeetCode, through this browser's own sign-ins.",
  "permissions": ["scripting", "tabs", "cookies"],
  "host_permissions": ["https://leetcode.com/*", "https://neetcode.io/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
