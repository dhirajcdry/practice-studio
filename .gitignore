node_modules/

# Vendored upstream repo — re-clone with scripts/index-solutions.mjs, never commit it here.
# Anchored: an unanchored "vendor/" would also swallow web/vendor/, which holds Monaco and
# MUST be committed, since the app has no build step and no CDN.
/vendor/

# Downloaded upstream bundles used to regenerate data/catalog.json.
*.bundle.js

# Never commit a LeetCode session cookie or any other secret. Studio submits through
# the browser extension and needs none (docs/SUBMITTING.md).
.env
.env.local
session.json

.DS_Store

# Playwright MCP page dumps left by Codex runs
.playwright-mcp/
